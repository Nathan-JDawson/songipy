SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_TOKEN_CACHE=.tokens.json
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Folder sync (`organize` command, local-only). SPOTIFY_USERNAME overrides the
# account username used in spclient rootlist URLs (otherwise derived from
# spotify.me()["id"]). SPOTIFY_CHROME_PROFILE is the dedicated logged-in Chrome
# profile dir (defaults to .spotify-chrome-profile/ under the repo root).
# SPOTIFY_CHROME_CHANNEL selects an installed browser ("chrome"/"msedge");
# leave unset to use Playwright's bundled Chromium.
SPOTIFY_USERNAME=
SPOTIFY_CHROME_PROFILE=
SPOTIFY_CHROME_CHANNEL=
FOLDER_SYNC_HEADLESS=0